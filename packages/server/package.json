{
  "name": "@agent-workshop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./db": "./dist/db.js",
    "./server": "./dist/server.js"
  },
  "scripts": {
