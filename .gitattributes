# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must always use LF (bash chokes on CRLF)
*.sh text eol=lf

# Windows batch files must use CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.sqlite binary
