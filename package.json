{
  "name": "agent-workshop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "predev": "pnpm --filter @agent-workshop/shared run build",
    "dev": "pnpm --parallel --filter ./packages/server --filter ./packages/web run dev",
    "predemo": "pnpm --filter @agent-workshop/shared run build",
    "demo": "pnpm --filter ./packages/web run demo",
    "build": "pnpm -r run build",
    "start": "node packages/cli/dist/main.js",
    "start:demo": "node packages/cli/dist/main.js demo",
    "pretest": "pnpm --filter @agent-workshop/shared run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "pretypecheck": "pnpm --filter @agent-workshop/shared run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
